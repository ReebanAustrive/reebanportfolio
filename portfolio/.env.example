# Copy this file to .env and fill in your values
VITE_GITHUB_USERNAME=your_github_username

# Optional: raises the GitHub API rate limit from 60 to 5000 requests/hour.
# WARNING: VITE_ variables are bundled into the public JavaScript, so anyone
# can read this token on the live site. Only use a fine-grained token with
# public, read-only access and no extra permissions.
VITE_GITHUB_TOKEN=
